# ==== LLM for picking viral moments ====
# Use either ANTHROPIC_API_KEY or OPENAI_API_KEY
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ==== Transcription ====
# faster-whisper runs locally. For CPU use "int8"; for GPU use "float16".
WHISPER_MODEL=base                # tiny|base|small|medium|large-v3
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu                # cpu | cuda

# ==== Clip generation ====
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=60
CLIPS_PER_VIDEO=5
CLIP_ASPECT=9:16                  # 9:16 (shorts/tiktok/reels) | 16:9 | 1:1
CAPTION_FONT=Arial
CAPTION_FONT_SIZE=52
CAPTION_COLOR=&H00FFFFFF          # ASS color (white)
CAPTION_OUTLINE_COLOR=&H00000000  # black
CAPTION_WORDS_PER_LINE=4

# ==== Storage ====
DATA_DIR=./data

# ==== YouTube (Data API v3, Shorts upload) ====
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json

# ==== TikTok Content Posting API ====
# You need an approved TikTok for Developers app with content.posting scope.
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# ==== Instagram Graph API (Reels) ====
# Business IG account connected to a Facebook Page, long-lived page token.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Clips must be reachable by a public URL for Instagram to fetch.
PUBLIC_BASE_URL=http://localhost:8000
